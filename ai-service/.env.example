# Copy this file to .env and adjust values for your environment.

APP_NAME=Smart Classroom AI Service
APP_VERSION=1.0.0
ENV=development
DEBUG=true

HOST=0.0.0.0
PORT=8000

# Comma-separated origins are not supported directly by pydantic-settings list parsing
# from .env; if you need multiple origins, set ALLOWED_ORIGINS as a JSON array string, e.g.
# ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8080"]
ALLOWED_ORIGINS=["*"]

UPLOAD_DIR=uploads
AUDIO_UPLOAD_DIR=uploads/audio
DOCUMENT_UPLOAD_DIR=uploads/documents
MAX_UPLOAD_SIZE_MB=200

WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu

SUMMARIZATION_MODEL=google/flan-t5-base
SUMMARY_MAX_LENGTH=220
SUMMARY_MIN_LENGTH=40

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

CHROMA_PERSIST_DIR=chroma_db
CHROMA_COLLECTION_NAME=classroom_documents

RAG_TOP_K=4
CHUNK_SIZE=500
CHUNK_OVERLAP=50

SPACY_MODEL=en_core_web_sm

SPRING_BOOT_BASE_URL=http://localhost:8080
INTERNAL_SERVICE_API_KEY=change-me-in-production

LOG_LEVEL=INFO

hello